# Required Cloudflare Realtime SFU credentials.
REALTIME_SFU_APP_ID=
REALTIME_SFU_BEARER_TOKEN=
SFU_API_BASE=https://rtc.live.cloudflare.com/v1

# Public origin the SFU dials for WebSocket-ingest tracks. Leave unset in
# production: the origin is taken from the incoming request. Set it to your
# tunnel URL to run locally, because the SFU cannot reach localhost.
# SFU_CALLBACK_ORIGIN=https://your-tunnel.trycloudflare.com
