{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signalwire-think-voice-agent-consolidation-test",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "main": "src/index.ts",
  "vars": {
    "RETAIL_MCP_SERVER_URL": "https://wpros-mcp.agenticflows.workers.dev/retail/mcp"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyVoiceAgent",
        "name": "MyVoiceAgent"
      },
      {
        "class_name": "MyThinkAgent",
        "name": "MyThinkAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["MyVoiceAgent", "MyThinkAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["RetailAgent"],
      "tag": "v2"
    }
  ]
}
