        <mxCell id="2" value="From Pipecat's speaking animation to real mouth synchronization" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1820" height="50" as="geometry" />
