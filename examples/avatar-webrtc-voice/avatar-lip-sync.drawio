        <mxCell id="10" value="Pipecat simple chatbot: speaking animation (not phoneme-synchronized)" style="swimlane;startSize=40;rounded=1;container=1;pointerEvents=0;html=1;fontSize=17;fontStyle=1;fillColor=#f5f5f5;strokeColor=#9ca3af;" vertex="1" parent="1">
