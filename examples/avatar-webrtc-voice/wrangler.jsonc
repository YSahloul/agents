{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "avatar-think-sfu-webrtc",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "routes": [
    {
      "pattern": "think.sahloul.io",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyThinkAgent",
        "name": "MyThinkAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["MyThinkAgent"],
      "tag": "v1"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/models"]
  }
}
