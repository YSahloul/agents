      {
        "class_name": "TestPersistentVoiceAgent",
        "name": "TestPersistentVoiceAgent"
      },
      {
        "class_name": "TestEmptyResponseVoiceAgent",
        "name": "TestEmptyResponseVoiceAgent"
      },
      {
        "class_name": "TestContextVoiceAgent",
        "name": "TestContextVoiceAgent"
      },
      {
        "class_name": "TestAiSdkFullStreamVoiceAgent",
        "name": "TestAiSdkFullStreamVoiceAgent"
      },
      {
        "class_name": "TestAiSdkTextStreamVoiceAgent",
        "name": "TestAiSdkTextStreamVoiceAgent"
      },
      {
        "class_name": "TestPcm24kVoiceAgent",
        "name": "TestPcm24kVoiceAgent"
      },
      {
        "class_name": "TestStreamingTtsVoiceAgent",
        "name": "TestStreamingTtsVoiceAgent"
      },
      {
        "class_name": "TestMinInterruptVoiceAgent",
        "name": "TestMinInterruptVoiceAgent"
      },
      {
        "class_name": "TestVoiceInputAgent",
        "name": "TestVoiceInputAgent"
      },
      {
        "class_name": "TestRejectCallVoiceInputAgent",
        "name": "TestRejectCallVoiceInputAgent"
      },
      {
        "class_name": "TestSFUVoiceAgent",
        "name": "TestSFUVoiceAgent"
      },
      {
        "class_name": "TestSFUTransportVoiceAgent",
        "name": "TestSFUTransportVoiceAgent"
      },
      {
        "class_name": "TestMissingSFUConfigAgent",
        "name": "TestMissingSFUConfigAgent"
      }
    ]
  },
  "main": "worker.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "TestVoiceAgent",
        "TestPersistentVoiceAgent",
        "TestEmptyResponseVoiceAgent",
        "TestContextVoiceAgent",
        "TestAiSdkFullStreamVoiceAgent",
        "TestAiSdkTextStreamVoiceAgent",
        "TestPcm24kVoiceAgent",
        "TestStreamingTtsVoiceAgent",
        "TestMinInterruptVoiceAgent",
        "TestVoiceInputAgent",
        "TestRejectCallVoiceInputAgent",
